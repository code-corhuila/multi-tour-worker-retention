# Variables the worker reads: the shared runtime ones (plan D-01) and its own.
BATCH_SIZE=100
RUN_TIMEOUT=30s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
# time between two runs (ADR-004 D10, once a day by default)
RETENTION_INTERVAL=24h
# where the health endpoint listens
HEALTH_ADDR=:8080
# internal base URL on the platform network: no trailing path, no credentials
COMMERCIAL_RESERVATION_BASE_URL=http://commercial-reservation-api:8083
# internal base URL of identity-audit, where the tenants are asked for when TENANT_IDS is empty: every tenant with its status
# (GET /internal/tenants?status=ALL, with the SERVICE token above); the active and the inactive ones are swept
IDENTITY_AUDIT_BASE_URL=http://identity-audit-api:8082
# optional, comma-separated tenant ids: a fallback that wins when set; set it only to pin the list
TENANT_IDS=
# a SERVICE token issued by multi-tour-security: `security issue-service-token worker-retention <duration>`; a secret of
# the environment, never versioned
SERVICE_TOKEN=
